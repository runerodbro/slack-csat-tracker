#!/bin/bash
# Show or change settings in /opt/csat/.env without a text editor.
#
#   csat-env               list all settings (values hidden)
#   csat-env NAME          set NAME; asks for the value and hides what you type
#
# Install: install -m 755 /opt/csat/deploy/csat-env /usr/local/bin/csat-env
set -euo pipefail

FILE=${CSAT_ENV_FILE:-/opt/csat/.env}

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root: sudo csat-env $*"
  exit 1
fi
touch "$FILE"

if [ $# -eq 0 ]; then
  awk '/^[A-Za-z_][A-Za-z0-9_]*=/ {
    name = substr($0, 1, index($0, "=") - 1); value = substr($0, index($0, "=") + 1)
    printf "  %-24s %s\n", name, (value == "" ? "EMPTY" : "set (" length(value) " characters)")
  }' "$FILE"
  echo
  echo "To change a setting: csat-env NAME   (for example: csat-env SLACK_BOT_TOKEN)"
  exit 0
fi

NAME=$1
if ! [[ $NAME =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
  echo "The name must be capital letters, digits and _, for example SLACK_BOT_TOKEN."
  exit 1
fi

read -rsp "Paste the new value for $NAME and press Enter (hidden): " VALUE
echo
VALUE=$(printf '%s' "$VALUE" | tr -d '\r\n')
VALUE=${VALUE#\"}; VALUE=${VALUE%\"}
if [ -z "$VALUE" ]; then
  echo "No value given. Nothing changed."
  exit 1
fi

# Replace the line if it exists, else add it. Written to a temp file first,
# so a failure never leaves a half-written .env.
TMP=$(mktemp "$FILE.XXXXXX")
trap 'rm -f "$TMP"' EXIT
NAME="$NAME" VALUE="$VALUE" awk '
  BEGIN { n = ENVIRON["NAME"]; v = ENVIRON["VALUE"] }
  index($0, n "=") == 1 { if (!done) print n "=" v; done = 1; next }
  { print }
  END { if (!done) print n "=" v }
' "$FILE" > "$TMP"
chmod 600 "$TMP"
chown --reference="$FILE" "$TMP" 2>/dev/null || true
id csat >/dev/null 2>&1 && chown csat:csat "$TMP"
mv "$TMP" "$FILE"
trap - EXIT

echo "$NAME saved (${#VALUE} characters)."
if systemctl is-active --quiet csat 2>/dev/null; then
  systemctl restart csat
  echo "App restarted with the new value."
fi
