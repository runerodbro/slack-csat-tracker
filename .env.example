# Copy to .env and fill in. Never commit .env.
INTERCOM_ACCESS_TOKEN=
INTERCOM_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

DB_PATH=/var/lib/csat/csat.db

# Optional
# PORT=3000
# TIMEZONE=Europe/Copenhagen
# POST_DELAY_SECONDS=300
# First day the streak and record count from. Use it to skip periods without
# real CSAT data. Default: the date of the oldest saved rating.
# STREAK_START_DATE=2023-10-01
# EU-hosted Intercom workspace:
# INTERCOM_API_URL=https://api.eu.intercom.io
# Found automatically from the access token if not set:
# INTERCOM_WORKSPACE_ID=
